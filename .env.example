PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/Demo
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Dashboard / storefront origins allowed to call the API (comma separated)
CLIENT_URLS=http://localhost:5173,http://localhost:3000

# First superadmin, created by "npm run seed"
ADMIN_NAME=Shop Owner
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-123

# Reject orders for sold-out sizes and show low-stock alerts
TRACK_STOCK=false

# Optional: can also be set from the dashboard (Settings page). Dashboard values win.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
META_PIXEL_ID=
META_ACCESS_TOKEN=

# Only one device can be signed in. A session unused this long ends, so the admin can sign in again.
SESSION_IDLE_MINUTES=15
